# Copy file nay thanh `.env` trong cung thu muc truoc khi chay.
# Vi du: `copy .env.example .env` tren Windows PowerShell.

# Ports exposed on the host machine
FE_PORT=4200
API_PORT=7100
POSTGRES_PORT=5432

# PostgreSQL for the containerized stack
POSTGRES_DB=WebBanHang
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend values are loaded from ../web_banhang_be/.env by docker-compose.yml.
