# ==============================================================================
# web_banhang_be - Backend .env.example
# Dùng khi chạy từng service RIÊNG LẺ (dotnet run / Visual Studio)
# KHÔNG cần khi chạy qua Docker Compose (dùng web_banhang/.env thay thế)
#
# CÁCH DÙNG:
#   copy .env.example .env  (Windows)
#   cp .env.example .env    (Linux/macOS)
# ==============================================================================

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
UseHttpsRedirection=false

# ==============================================================================
# DATABASE - chỉnh theo DB local của bạn
# ==============================================================================
# Nếu dùng chung 1 DB (monolith cũ):
ConnectionStrings__PostgresConnection=Host=localhost;Port=5432;Database=WebBanHang;Username=postgres;Password=postgres

# Hoặc nếu chạy riêng từng microservice DB:
# ConnectionStrings__IdentityDb=Host=localhost;Port=5433;Database=identity_db;Username=postgres;Password=postgres
# ConnectionStrings__CatalogDb=Host=localhost;Port=5434;Database=catalog_db;Username=postgres;Password=postgres
# ConnectionStrings__CartDb=Host=localhost;Port=5432;Database=cart_db;Username=postgres;Password=postgres

# ==============================================================================
# RABBITMQ
# ==============================================================================
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# ==============================================================================
# REDIS
# ==============================================================================
Redis__ConnectionString=localhost:6379

# ==============================================================================
# CORS
# ==============================================================================
AllowedOrigins=http://localhost:4200

# ==============================================================================
# JWT  ⚠️ đổi trước khi dùng thật
# ==============================================================================
JwtSettings__SecretKey=auramart-dev-jwt-secret-key-minimum-32-chars!!
JwtSettings__Issuer=AuraMart
JwtSettings__Audience=AuraMart
JwtSettings__ExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=7

# ==============================================================================
# EXTERNAL SERVICES (để trống nếu không dùng)
# ==============================================================================
Supabase__Url=
Supabase__ServiceRoleKey=
Supabase__StorageBucket=product-images

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# ==============================================================================
# APP
# ==============================================================================
DemoSeed__Enabled=true
