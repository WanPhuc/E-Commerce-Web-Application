# ==============================================================================
# AuraMart Microservices - Environment Configuration (.env.example)
# 
# CÁCH DÙNG:
#   Windows (PowerShell):  copy .env.example .env
#   Linux/macOS:           cp .env.example .env
#
# Sau đó mở .env và điền các giá trị thật (đặc biệt phần SECRETS).
# File .env KHÔNG được commit lên git.
# ==============================================================================

# ==============================================================================
# PORTS - Exposed to host machine
# ==============================================================================

# --- Frontend ---
FE_PORT=4200

# --- API Gateway (Ocelot / YARP) ---
GATEWAY_PORT=8080

# --- Microservices ---
IDENTITY_PORT=8081
CATALOG_PORT=8082
CART_PORT=8083
ORDERING_PORT=8084
NOTIFICATION_PORT=8085
PAYMENT_PORT=8086
SELLER_PORT=8088

# --- Databases (host port -> container:5432) ---
IDENTITY_DB_PORT=5433
CATALOG_DB_PORT=5434
CART_DB_PORT=5432
ORDERING_DB_PORT=5435
PAYMENT_DB_PORT=5436
SELLER_DB_PORT=5437
NOTIFICATION_DB_PORT=5438

# --- Message Broker ---
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Cache ---
REDIS_PORT=6379

# ==============================================================================
# DATABASE CREDENTIALS
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==============================================================================
# RABBITMQ CREDENTIALS
# ==============================================================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ==============================================================================
# JWT CONFIGURATION  ⚠️ CHANGE IN PRODUCTION
# ==============================================================================
JWT_SECRET_KEY=auramart-dev-jwt-secret-key-minimum-32-chars!!
JWT_ISSUER=AuraMart
JWT_AUDIENCE=AuraMart
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_DAYS=7

# ==============================================================================
# INTERNAL SERVICE SECURITY
# ==============================================================================
INTERNAL_API_KEY=dev-internal-key-change-in-production

# ==============================================================================
# EXTERNAL SERVICES (Optional - leave empty to disable)
# ==============================================================================

# --- Supabase Storage (for product images) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# APP SETTINGS
# ==============================================================================

# Cho phép CORS từ frontend
ALLOWED_ORIGINS=http://localhost:4200

# Seed dữ liệu demo khi khởi động lần đầu
DEMO_SEED_ENABLED=true
